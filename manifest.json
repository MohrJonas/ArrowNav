{
  "manifest_version": 3,
  "name": "ArrowNav",
  "version": "1.0",

  "description": "Navigate via arrow keys",

  "icons": {
    "48": "icon.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "arrownav@al1as.me",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"]
    }
  ]
}
